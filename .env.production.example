# Production runtime placeholders. Copy onto the server; do not commit real values.

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Public hostname Traefik should route to (no scheme).
# Set this after the production hostname is confirmed.
APP_HOST=replace-with-production-hostname.example.com

# Production canonical origin (scheme + host, no trailing slash).
# Indexing, canonical URLs, and sitemap.xml are enabled only when this is set.
PUBLIC_CANONICAL_ORIGIN=https://replace-with-canonical-origin.example.com

# Server-only. Restrict the key to Places API (New). Never use PUBLIC_ or VITE_.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
