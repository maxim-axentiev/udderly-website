# Local development defaults.
# Copy to .env if you need overrides. Do not commit real values.

NODE_ENV=development
HOST=127.0.0.1
PORT=8080

# Public hostname used by Traefik on a deployed server (not required locally).
# Example: staging.example.com
APP_HOST=

# Leave empty for local/staging so robots.txt disallows crawling and no
# canonical URLs or sitemap are emitted. Set only for the real production origin.
# Example: https://example.com
PUBLIC_CANONICAL_ORIGIN=
