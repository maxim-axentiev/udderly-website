# Local development defaults.
# Copy to .env if you need overrides. Do not commit real values.

NODE_ENV=development
HOST=127.0.0.1
PORT=8080

# Public hostname used by Traefik on a deployed server (not required locally).
# Example: staging.example.com
APP_HOST=

# Leave empty for local/staging so robots.txt disallows crawling and no
# canonical URLs or sitemap are emitted. Set only for the real production origin.
# Example: https://example.com
PUBLIC_CANONICAL_ORIGIN=

# Public Sanity IDs (not secrets). Defaults are already in src/lib/sanity/config.ts.
PUBLIC_SANITY_PROJECT_ID=umbuxpyp
PUBLIC_SANITY_DATASET=production

# Server-only Google Places API (New) credentials for homepage reviews.
# Do not prefix these with PUBLIC_ or VITE_ — they must never reach the browser.
# Restrict a new Google Cloud key to Places API (New) only.
# The homepage still renders if either value is missing.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
